# Yahoo app (developer.yahoo.com/apps). Redirect URI on the app: https://<your-app>.vercel.app/api/yahoo/callback
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# 32 random bytes, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Public https URL of this deployment, no trailing slash (falls back to VERCEL_PROJECT_PRODUCTION_URL).
PUBLIC_BASE_URL=
# Upstash Redis (Vercel Marketplace sets KV_REST_API_URL / KV_REST_API_TOKEN automatically).
KV_REST_API_URL=
KV_REST_API_TOKEN=
